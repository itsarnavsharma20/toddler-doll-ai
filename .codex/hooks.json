{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/guardrails/guard.py --format codex",
            "timeout": 10,
            "statusMessage": "Checking guardrails"
          }
        ]
      }
    ]
  }
}
